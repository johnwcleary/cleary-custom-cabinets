---
import { Image } from 'astro:assets';
import { postHref, formatDate, type Post } from '../lib/content';
import { widthsFor } from '../lib/img';

interface Props {
  posts: Post[];
  /** Heading level of each post's title: 2 on the blog page, 3 under a section heading. */
  level?: 2 | 3;
}
const { posts, level = 2 } = Astro.props;
const Title = `h${level}` as const;
---

<!-- One post to a row, under a rule: the photo on the left (above, on a phone), then the date, the title, the summary and a
     button to read it. The photo and the title open the post too; the photo is left out of the keyboard order, since the
     title and the button already go there. -->
<ul class="max-w-[62rem]">
  {
    posts.map((p) => (
      <li class="grid grid-cols-1 items-center gap-x-8 gap-y-3 border-t border-line py-6 first:border-t-0 first:pt-0 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
        <a href={postHref(p)} class="hl block aspect-[3/2] overflow-hidden" tabindex="-1">
          <Image src={p.data.image} alt={p.data.imageAlt} widths={widthsFor(p.data.image, [400, 640, 960])} sizes="(min-width: 1024px) 24rem, (min-width: 640px) 38vw, 92vw" class="photo" />
        </a>
        <div>
          <p class="text-muted"><time datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time></p>
          <Title class="display mt-1 text-[1.5rem] leading-tight lg:text-[1.75rem]">
            <a href={postHref(p)} class="underline decoration-transparent decoration-[max(2px,0.07em)] underline-offset-[0.2em] hover:decoration-current">{p.data.title}</a>
          </Title>
          <p class="mt-2 text-muted">{p.data.description}</p>
          <p class="mt-4"><a href={postHref(p)} class="btn">Read the article<span class="sr-only">: {p.data.title}</span></a></p>
        </div>
      </li>
    ))
  }
</ul>
