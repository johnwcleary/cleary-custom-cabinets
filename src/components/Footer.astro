---
import Hours from './Hours.astro';
import SocialLinks from './SocialLinks.astro';
import Stamp from './sheet/Stamp.astro';
import { site } from '../lib/site';

// The name on one line, lettered like the logo; the rest of the tagline smaller on the next.
const rest = site.tagline.startsWith(site.name) ? site.tagline.slice(site.name.length).replace(/^[,\s]+/, '') : null;
---

<footer class="on-plum bg-plum-deep text-white">
  <div class="frame pt-[clamp(2rem,4vw,3.25rem)] pb-[clamp(1.75rem,3.5vw,3rem)]">
    <div class="flex items-center justify-between gap-6 pb-[clamp(1.5rem,3vw,2.5rem)]">
      {
        rest !== null ? (
          <p class="sign">
            <span class="sign__name">{site.name},</span>
            <span class="sign__rest">{rest}</span>
          </p>
        ) : (
          <p class="sign">{site.tagline}</p>
        )
      }
      <Stamp id="stamp-footer" tilt={-11} class="w-24 shrink-0 text-blush sm:w-32 lg:w-40" />
    </div>
    <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1.35fr_0.75fr]">
      <div>
        <h2 class="foot-label">Visit</h2>
        <address class="not-italic">
          <a href={site.mapsUrl} rel="noopener" class="ulink tap py-2 leading-snug">{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</a>
        </address>
      </div>
      <div>
        <h2 class="foot-label">Call or email</h2>
        <p><a href={site.phoneHref} class="ulink tap text-[1.375rem] font-semibold tabular-nums">{site.phone}</a></p>
        <p><a href={`mailto:${site.email}`} class="ulink tap [overflow-wrap:anywhere]">{site.email}</a></p>
      </div>
      <div>
        <h2 class="foot-label">Showroom hours</h2>
        <Hours class="hours-table max-w-[21rem] pt-2.5" />
      </div>
      <div>
        <h2 class="foot-label">Follow</h2>
        <SocialLinks labels class="social-list flex flex-col" />
      </div>
    </div>
  </div>
</footer>

<style>
  /* One label style for every column, so the four line up along the top. */
  .foot-label {
    color: var(--color-blush);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }
</style>
