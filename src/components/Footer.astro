---
import Logo from './Logo.astro';
import Hours from './Hours.astro';
import SocialLinks from './SocialLinks.astro';
import { site } from '../lib/site';
import { getServices, serviceHref } from '../lib/content';
import { pad2 } from '../lib/img';

const services = await getServices();
// These pages already show the hours just above the footer, so phones skip the repeat.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const hoursAbove = ['/', '/about', '/contact'].includes(path);
---

<!-- The title block, as it sits in the corner of every sheet in a set. -->
<footer class="mt-0">
  <div class="frame border-t border-ink">
    <div class="ruled grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1.1fr_1.45fr_0.65fr]">
      <div class="p-4 lg:p-5">
        <Logo width={170} class="mb-5 h-auto w-40" />
        <p class="lead !text-[1.5rem] max-w-[24ch]">{site.tagline}</p>
      </div>
      <div class="p-4 lg:p-5">
        <h2 class="mono mb-2.5 text-muted">Visit</h2>
        <address class="not-italic">
          <a href={site.mapsUrl} rel="noopener" class="ulink">{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</a>
        </address>
        <p class="mono mt-4 max-w-[28ch] text-muted">{site.serviceArea}</p>
      </div>
      <div class="p-4 lg:p-5">
        <h2 class="mono mb-2.5 text-muted">Call &amp; write</h2>
        <p><a href={site.phoneHref} class="caps text-[1.75rem] tabular-nums hover:text-pencil">{site.phone}</a></p>
        <p class="mt-1.5"><a href={`mailto:${site.email}`} class="ulink text-[0.875rem] [overflow-wrap:anywhere]">{site.email}</a></p>
      </div>
      <div class:list={['p-4 lg:p-5', hoursAbove && 'hidden sm:block']}>
        <h2 class="mono mb-2.5 text-muted">Showroom hours</h2>
        <Hours class="hours-table text-[0.9375rem]" />
      </div>
      <div class="p-4 lg:p-5">
        <h2 class="mono mb-2.5 text-muted">Follow</h2>
        <SocialLinks labels class="social-list flex flex-col gap-1.5 text-[0.9375rem]" />
      </div>
    </div>
    <nav aria-label="Cabinets and products" class="hidden border-t border-line sm:block">
      <ul class="ruled grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7">
        {
          services.map((s) => (
            <li>
              <a href={serviceHref(s.data.slug)} class="mono flex h-full gap-2 px-4 py-2.5 hover:text-pencil lg:px-3 focus-visible:[outline-offset:-2px]">
                <span class="text-muted">{pad2(s.data.order)}</span>
                <span>{s.data.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="h-3 sm:h-5"></div>
</footer>
