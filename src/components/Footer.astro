---
import Hours from './Hours.astro';
import Logo from './Logo.astro';
import Map from './Map.astro';
import { site } from '../lib/site';

interface Props {
  /** The small map at the end of the row. Left off where the page already shows a large one. */
  map?: boolean;
}
const { map = true } = Astro.props;
// The boxed logo already carries the name, so only the rest of the tagline is set under it.
const motto = site.tagline.startsWith(site.name) ? site.tagline.slice(site.name.length).replace(/^[,\s]+/, '') : site.tagline;
const year = new Date().getFullYear();
---

<footer class="on-blue bg-blue text-white">
  <!-- One short row on a wide screen: the logo; the phone, email and address, which need no label; the hours;
       and the map filling the height of the row. A line of small print closes the page. -->
  <div class="frame pt-[clamp(1.75rem,3vw,2.5rem)]">
    <div class:list={['grid grid-cols-1 gap-x-10 gap-y-6 sm:grid-cols-2', map ? 'lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)_minmax(0,1.1fr)_minmax(0,1.25fr)]' : 'lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)_minmax(0,1.1fr)]']}>
      <div>
        <Logo variant="reverse" width={240} decorative={false} class="h-auto w-[11.5rem] lg:w-[12.5rem]" />
        <p class="foot-motto mt-3">{motto}</p>
      </div>
      <address class="not-italic">
        <p><a href={site.phoneHref} class="plain-link tap -mt-2.5 text-[1.375rem] font-semibold tabular-nums">{site.phone}</a></p>
        <p><a href={`mailto:${site.email}`} class="plain-link tap [overflow-wrap:anywhere]">{site.email}</a></p>
        <p><a href={site.mapsUrl} rel="noopener" class="plain-link tap py-1 leading-snug">{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</a></p>
      </address>
      <div>
        <h2 class="foot-label">Showroom hours</h2>
        <Hours class="hours-table max-w-[21rem] pt-1" />
      </div>
      {map && <Map class="aspect-[2/1] lg:aspect-auto lg:min-h-[11rem]" />}
    </div>
    <p class="foot-print mt-[clamp(1.5rem,3vw,2rem)] border-t border-white/30 py-3">&copy; {year} {site.name} &middot; {site.address.city}, {site.address.state}</p>
  </div>
</footer>

<style>
  .foot-motto {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
    font-style: italic;
    line-height: 1.3;
  }
  /* One label style for every column, so they line up along the top. */
  .foot-label {
    margin-bottom: 0.125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .foot-print {
    font-size: 1rem;
  }
</style>
