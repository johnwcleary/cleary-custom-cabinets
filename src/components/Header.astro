---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import { site } from '../lib/site';
import { getServices, serviceHref, heroCaption, getAllGallery } from '../lib/content';
import { pad2, widthsFor } from '../lib/img';

const services = await getServices();
const gallery = await getAllGallery();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : undefined);
---

<div class="on-dark bg-pencil text-paper">
  <p class="mono px-4 py-1.5 text-center text-[0.625rem] sm:text-[0.6875rem]">{site.announcement || site.serviceArea}</p>
</div>
<header class="sticky top-0 z-40 bg-paper">
  <div class="frame flex h-14 items-stretch border-b border-ink lg:h-[4.5rem]">
    <a href="/" class="flex shrink-0 items-center border-r border-line px-3 sm:px-4 lg:px-5" aria-label={`${site.name}, home`}>
      <Logo width={150} class="h-auto w-28 lg:w-[9.25rem]" />
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="mono flex h-full items-stretch">
        <li class="flex">
          <button type="button" class="group flex cursor-pointer items-center gap-2 border-r border-line px-5 uppercase hover:text-pencil focus-visible:[outline-offset:-2px]" aria-expanded="false" aria-controls="cabinets-menu" data-disclosure>
            Cabinets
            <svg width="9" height="9" viewBox="0 0 10 10" aria-hidden="true" class="group-aria-expanded:rotate-180"><path d="M1 3.5 5 7l4-3.5" fill="none" stroke="currentColor" stroke-width="1.2"></path></svg>
          </button>
          <div id="cabinets-menu" class="absolute inset-x-0 top-full bg-paper normal-case tracking-normal" hidden>
            <div class="frame border-b border-ink">
              <ul class="ruled grid grid-cols-7">
                {
                  services.map((s) => (
                    <li>
                      <a href={serviceHref(s.data.slug)} class="group block h-full p-3 hover:text-pencil focus-visible:[outline-offset:-2px]" aria-current={current(serviceHref(s.data.slug))}>
                        <span class="mono mb-2 block text-muted">{pad2(s.data.order)}</span>
                        <span class="mb-2.5 block aspect-[4/3] overflow-hidden">
                          <Image src={s.data.heroImage} alt={heroCaption(s, gallery)} widths={widthsFor(s.data.heroImage, [240, 400])} sizes="13vw" class="photo" loading="lazy" />
                        </span>
                        <span class="caps block text-[1.375rem]">{s.data.shortName ?? s.data.title}</span>
                        <span class="mono mt-1 block text-muted">{s.data.title}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </li>
        <li class="flex"><a href="/about" class:list={['flex items-center border-r border-line px-5 hover:text-pencil focus-visible:[outline-offset:-2px]', current('/about') && 'nav-on']} aria-current={current('/about')}>About</a></li>
        <li class="flex"><a href="/contact" class:list={['flex items-center border-r border-line px-5 hover:text-pencil focus-visible:[outline-offset:-2px]', current('/contact') && 'nav-on']} aria-current={current('/contact')}>Contact</a></li>
      </ul>
    </nav>
    <a href={site.mapsUrl} rel="noopener" class="mono ml-auto hidden flex-col justify-center border-l border-line px-5 text-muted hover:text-pencil xl:flex focus-visible:[outline-offset:-2px]">
      <span>{site.address.street}</span>
      <span>{site.address.city}, {site.address.state} {site.address.zip}</span>
    </a>
    <a href={site.phoneHref} class="ml-auto hidden flex-col justify-center border-l border-line px-4 hover:text-pencil sm:flex lg:px-5 xl:ml-0 focus-visible:[outline-offset:-2px]">
      <span class="mono hidden text-muted lg:block">Call</span>
      <span class="caps text-[1.5rem] tabular-nums lg:text-[1.75rem]">{site.phone}</span>
    </a>
    <!-- Phones: a call button instead of the number, to keep the bar quiet. -->
    <a href={site.phoneHref} class="ml-auto grid w-14 place-items-center border-l border-line sm:hidden focus-visible:[outline-offset:-2px]" aria-label={`Call ${site.phone}`}>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path></svg>
    </a>
    <button type="button" class="mono cursor-pointer border-l border-line px-4 lg:hidden focus-visible:[outline-offset:-2px]" aria-expanded="false" aria-controls="mobile-menu" data-disclosure>Menu</button>
  </div>

  <div id="mobile-menu" class="absolute inset-x-0 top-full h-[calc(100dvh-3.5rem)] overflow-y-auto bg-paper lg:hidden" hidden>
    <nav aria-label="Main (mobile)" class="frame min-h-full">
      <ul>
        {
          services.map((s) => (
            <li class="border-b border-line">
              <a href={serviceHref(s.data.slug)} class="flex items-baseline gap-3 px-4 py-3" aria-current={current(serviceHref(s.data.slug))}>
                <span class="mono text-muted">{pad2(s.data.order)}</span>
                <span class="caps text-[1.75rem]">{s.data.shortName ?? s.data.title}</span>
              </a>
            </li>
          ))
        }
        <li class="border-b border-line"><a href="/about" class="caps block px-4 py-3 text-[1.75rem]" aria-current={current('/about')}>About</a></li>
        <li class="border-b border-line"><a href="/contact" class="caps block px-4 py-3 text-[1.75rem]" aria-current={current('/contact')}>Contact</a></li>
      </ul>
      <p class="px-4 pt-5"><a href={site.phoneHref} class="caps block text-[2.25rem] tabular-nums text-pencil">{site.phone}</a></p>
      <p class="mono px-4 pt-2 pb-6 text-muted">{site.address.street}, {site.address.city}, {site.address.state} {site.address.zip}</p>
    </nav>
  </div>
</header>

<style>
  .nav-on {
    box-shadow: inset 0 -2px 0 var(--color-pencil);
  }
</style>

<script>
  // Disclosure buttons: toggle the controlled panel; Esc or an outside click closes it.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-disclosure]')];
  const panelOf = (b: HTMLButtonElement) => document.getElementById(b.getAttribute('aria-controls')!)!;
  const close = (b: HTMLButtonElement, focus = false) => {
    if (b.getAttribute('aria-expanded') !== 'true') return;
    b.setAttribute('aria-expanded', 'false');
    panelOf(b).hidden = true;
    if (focus) b.focus();
  };
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') !== 'true';
      buttons.forEach((o) => o !== b && close(o));
      b.setAttribute('aria-expanded', String(open));
      panelOf(b).hidden = !open;
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    buttons.forEach((b) => b.getAttribute('aria-expanded') === 'true' && close(b, true));
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    buttons.forEach((b) => !b.contains(t) && !panelOf(b).contains(t) && close(b));
  });
  document.addEventListener('focusin', (e) => {
    const t = e.target as Node;
    buttons.forEach((b) => b.getAttribute('aria-controls') === 'cabinets-menu' && !b.contains(t) && !panelOf(b).contains(t) && close(b));
  });
</script>
