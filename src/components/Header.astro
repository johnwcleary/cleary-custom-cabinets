---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import { site } from '../lib/site';
import { getServices, serviceHref, heroCaption, getAllGallery } from '../lib/content';
import { widthsFor } from '../lib/img';

const services = await getServices();
const gallery = await getAllGallery();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : undefined);
---

<div class="on-dark bg-pencil text-paper">
  <p class="px-4 py-1.5 text-center text-[0.8125rem] font-medium">{site.announcement || site.serviceArea}</p>
</div>
<header class="sticky top-0 z-40 border-b border-line bg-paper">
  <div class="frame flex h-14 items-center gap-5 lg:h-16 lg:gap-8">
    <a href="/" class="shrink-0" aria-label={`${site.name}, home`}>
      <Logo variant="mark" width={92} class="h-auto w-16 lg:w-[5.75rem]" />
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-[1.0625rem] font-medium">
        <li>
          <button type="button" class="nav-link flex cursor-pointer items-center gap-1.5" aria-expanded="false" aria-controls="cabinets-menu" data-disclosure>
            Cabinets
            <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3.5 5 7l4-3.5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
          </button>
          <div id="cabinets-menu" class="absolute inset-x-0 top-full border-b border-line bg-paper" hidden>
            <ul class="frame grid grid-cols-7 gap-3 py-4">
              {
                services.map((s) => (
                  <li>
                    <a href={serviceHref(s.data.slug)} class="group block" aria-current={current(serviceHref(s.data.slug))}>
                      <span class="mb-2 block aspect-[4/3] overflow-hidden rounded-[4px]">
                        <Image src={s.data.heroImage} alt={heroCaption(s, gallery)} widths={widthsFor(s.data.heroImage, [240, 400])} sizes="13vw" class="photo" loading="lazy" />
                      </span>
                      <span class="block transition-colors duration-200 group-hover:text-pencil">{s.data.shortName ?? s.data.title}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        <li><a href="/about" class:list={['nav-link', current('/about') && 'text-pencil']} aria-current={current('/about')}>About</a></li>
        <li><a href="/contact" class:list={['nav-link', current('/contact') && 'text-pencil']} aria-current={current('/contact')}>Contact</a></li>
      </ul>
    </nav>
    <a href={site.phoneHref} class="ml-auto text-[1.125rem] font-semibold tabular-nums transition-colors duration-200 hover:text-pencil lg:text-[1.375rem]">{site.phone}</a>
    <button type="button" class="cursor-pointer text-[1.0625rem] font-medium lg:hidden" aria-expanded="false" aria-controls="mobile-menu" data-disclosure>Menu</button>
  </div>

  <div id="mobile-menu" class="absolute inset-x-0 top-full h-[calc(100dvh-3.5rem)] overflow-y-auto bg-paper lg:hidden" hidden>
    <nav aria-label="Main (mobile)" class="frame py-5">
      <ul class="space-y-3 text-[1.5rem] font-medium">
        {services.map((s) => <li><a href={serviceHref(s.data.slug)} aria-current={current(serviceHref(s.data.slug))}>{s.data.shortName ?? s.data.title}</a></li>)}
        <li class="pt-3"><a href="/about" aria-current={current('/about')}>About</a></li>
        <li><a href="/contact" aria-current={current('/contact')}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Disclosure buttons: toggle the controlled panel; Esc or an outside click closes it.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-disclosure]')];
  const panelOf = (b: HTMLButtonElement) => document.getElementById(b.getAttribute('aria-controls')!)!;
  const close = (b: HTMLButtonElement, focus = false) => {
    if (b.getAttribute('aria-expanded') !== 'true') return;
    b.setAttribute('aria-expanded', 'false');
    panelOf(b).hidden = true;
    if (focus) b.focus();
  };
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') !== 'true';
      buttons.forEach((o) => o !== b && close(o));
      b.setAttribute('aria-expanded', String(open));
      panelOf(b).hidden = !open;
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    buttons.forEach((b) => b.getAttribute('aria-expanded') === 'true' && close(b, true));
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    buttons.forEach((b) => !b.contains(t) && !panelOf(b).contains(t) && close(b));
  });
  document.addEventListener('focusin', (e) => {
    const t = e.target as Node;
    buttons.forEach((b) => b.getAttribute('aria-controls') === 'cabinets-menu' && !b.contains(t) && !panelOf(b).contains(t) && close(b));
  });
</script>
