---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import { site } from '../lib/site';
import { getServices, serviceHref, heroCaption, getAllGallery, getBrandGroups } from '../lib/content';
import { sentenceCase } from '../lib/text';
import { widthsFor } from '../lib/img';

const services = await getServices();
const gallery = await getAllGallery();
// A promotion typed in capitals is shown in sentence case; brand names keep their capitals.
const brands = (await getBrandGroups()).flatMap((g) => g.data.items.map((b) => b.name));
const announcement = sentenceCase(site.announcement || site.serviceArea, brands);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : undefined);
---

<div class="on-dark bg-pencil text-white">
  <p class="frame py-2 text-center font-medium leading-snug">{announcement}</p>
</div>
<header class="sticky top-0 z-40 border-b border-line bg-paper">
  <div class="frame flex h-16 items-center gap-4 lg:h-[4.5rem] lg:gap-8">
    <a href="/" class="tap shrink-0" aria-label={`${site.name}, home`}>
      <Logo variant="mark" width={92} class="h-auto w-14 min-[360px]:w-16 lg:w-[5.25rem]" />
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        <li>
          <button type="button" class="nav-link tap cursor-pointer gap-2" aria-expanded="false" aria-controls="cabinets-menu" data-disclosure>
            Cabinets
            <svg width="12" height="12" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3.5 5 7l4-3.5" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
          </button>
          <div id="cabinets-menu" class="absolute inset-x-0 top-full border-b border-line bg-paper" hidden>
            <ul class="frame grid grid-cols-7 gap-4 py-5">
              {
                services.map((s) => (
                  <li>
                    <a href={serviceHref(s.data.slug)} class="group block" aria-current={current(serviceHref(s.data.slug))}>
                      <span class="mb-2 block aspect-[4/3] overflow-hidden">
                        <Image src={s.data.heroImage} alt={heroCaption(s, gallery)} widths={widthsFor(s.data.heroImage, [240, 400])} sizes="13vw" class="photo" loading="lazy" />
                      </span>
                      <span class="nav-link block group-hover:[text-decoration-color:currentColor]">{s.data.shortName ?? s.data.title}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        <li><a href="/about" class="nav-link tap" aria-current={current('/about')}>About</a></li>
        <li><a href="/contact" class="nav-link tap" aria-current={current('/contact')}>Contact</a></li>
      </ul>
    </nav>
    <a href={site.phoneHref} class="ulink tap ml-auto text-[1.125rem] font-semibold tabular-nums lg:text-[1.375rem]">{site.phone}</a>
    <button type="button" class="tap cursor-pointer border-2 border-ink px-3 font-semibold lg:hidden" aria-expanded="false" aria-controls="mobile-menu" data-disclosure>Menu</button>
  </div>

  <div id="mobile-menu" class="absolute inset-x-0 top-full h-[calc(100dvh-4rem)] overflow-y-auto bg-paper lg:hidden" hidden>
    <nav aria-label="Main (mobile)" class="frame py-4">
      <ul class="text-[1.375rem] font-medium">
        {services.map((s) => <li><a href={serviceHref(s.data.slug)} class="nav-link tap w-full" aria-current={current(serviceHref(s.data.slug))}>{s.data.shortName ?? s.data.title}</a></li>)}
        <li class="mt-4"><a href="/about" class="nav-link tap w-full" aria-current={current('/about')}>About</a></li>
        <li><a href="/contact" class="nav-link tap w-full" aria-current={current('/contact')}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Disclosure buttons: toggle the controlled panel; Esc or an outside click closes it.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-disclosure]')];
  const panelOf = (b: HTMLButtonElement) => document.getElementById(b.getAttribute('aria-controls')!)!;
  const close = (b: HTMLButtonElement, focus = false) => {
    if (b.getAttribute('aria-expanded') !== 'true') return;
    b.setAttribute('aria-expanded', 'false');
    panelOf(b).hidden = true;
    if (focus) b.focus();
  };
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') !== 'true';
      buttons.forEach((o) => o !== b && close(o));
      b.setAttribute('aria-expanded', String(open));
      panelOf(b).hidden = !open;
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    buttons.forEach((b) => b.getAttribute('aria-expanded') === 'true' && close(b, true));
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    buttons.forEach((b) => !b.contains(t) && !panelOf(b).contains(t) && close(b));
  });
  document.addEventListener('focusin', (e) => {
    const t = e.target as Node;
    buttons.forEach((b) => b.getAttribute('aria-controls') === 'cabinets-menu' && !b.contains(t) && !panelOf(b).contains(t) && close(b));
  });
</script>
