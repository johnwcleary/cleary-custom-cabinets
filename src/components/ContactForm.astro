---
import { site } from '../lib/site';

interface Props {
  heading?: string;
  helper?: string;
  /** The "Or call us" line under the button. Left off where the phone number is already beside the form. */
  call?: boolean;
  class?: string;
}
const { heading, helper, call = true, class: className } = Astro.props;
---

<!--
  One form, the same three questions on every page that has it. It posts nowhere yet. At launch it is wired to a backend (Cloudflare Pages Function + email,
  or Formspree) — find it by data-form-backend. The honeypot field ("company") must stay empty.
-->
<form class:list={['cform', className]} action="#" method="post" data-form-backend="todo-phase-2">
  {heading && <h2 class="cform__title">{heading}</h2>}
  <p class="cform__field">
    <label for="cf-name">Your name</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required />
  </p>
  <p class="cform__field">
    <label for="cf-contact">Your phone number or email</label>
    <input id="cf-contact" name="contact" type="text" required />
  </p>
  <p class="cform__field">
    <label for="cf-message">Tell us about your project</label>
    <textarea id="cf-message" name="message" rows="3"></textarea>
  </p>
  <p class="sr-only-baseline" aria-hidden="true">
    <label for="cf-company">Leave this field empty</label>
    <input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </p>
  {helper && <p class="cform__help">{helper}</p>}
  <button type="submit" class="btn cform__send">Send</button>
  {call && <p class="cform__call">Or call us: <a href={site.phoneHref} class="ulink tap tabular-nums">{site.phone}</a></p>}
</form>

<style>
  /* No frame of its own: plainly boxed places to type, in line with the page. Where the form sits on a
     photograph, the --cform-* properties turn its words, box edges and focus ring white. */
  .cform {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    background: var(--cform-bg, #fff);
    color: var(--cform-ink, inherit);
  }
  .cform__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2vw, 1.75rem);
    font-weight: 400;
    line-height: 1.2;
    text-wrap: balance;
  }
  .cform__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
  }
  .cform__field:has(textarea) {
    flex: 1;
  }
  .cform label {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .cform input,
  .cform textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.625rem 0.75rem;
    background: #fff;
    border: 1px solid var(--cform-edge, var(--color-control));
    border-radius: 0;
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--color-ink);
    transition: border-color 0.15s ease;
  }
  @media (hover: hover) {
    .cform input:hover,
    .cform textarea:hover {
      border-color: var(--cform-edge, var(--color-ink));
    }
  }
  .cform textarea {
    flex: 1;
    min-height: 4.5rem;
    resize: vertical;
  }
  .cform input:focus-visible,
  .cform textarea:focus-visible {
    outline: 3px solid var(--cform-ring, var(--color-pencil));
    outline-offset: var(--cform-ring-gap, 0);
    border-color: var(--cform-ring, var(--color-pencil));
    box-shadow: none;
  }
  .cform__help {
    margin: 0;
    color: var(--color-muted);
  }
  .cform__send {
    width: 100%;
    font-size: 1.25rem;
  }
  .cform__call {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 0.4em;
    margin: -0.375rem 0;
    font-size: 1.0625rem;
  }
  .cform__call a {
    font-weight: 600;
  }
</style>
