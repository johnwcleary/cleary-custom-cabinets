---
import { site } from '../lib/site';

interface Props {
  heading?: string;
  helper?: string;
  /** The "Or call us" line under the button. Left off where the phone number is already beside the form. */
  call?: boolean;
  class?: string;
}
const { heading, helper, call = true, class: className } = Astro.props;
---

<!--
  One form, the same three questions on every page that has it. It posts to the Cloudflare Pages Function in
  functions/api/contact.ts, which emails the shop. The script below sends it without leaving the page; without
  JavaScript the browser posts it and lands on /thanks/. The honeypot field ("company") must stay empty.
-->
<form class:list={['cform', className]} action="/api/contact" method="post" data-cform>
  {heading && <h2 class="cform__title">{heading}</h2>}
  <p class="cform__field">
    <label for="cf-name">Your name</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required />
  </p>
  <p class="cform__field">
    <label for="cf-contact">Your phone number or email</label>
    <input id="cf-contact" name="contact" type="text" required />
  </p>
  <p class="cform__field">
    <label for="cf-message">Tell us about your project</label>
    <textarea id="cf-message" name="message" rows="3"></textarea>
  </p>
  <p class="sr-only-baseline" aria-hidden="true">
    <label for="cf-company">Leave this field empty</label>
    <input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </p>
  {helper && <p class="cform__help">{helper}</p>}
  <button type="submit" class="btn cform__send">Send</button>
  <p class="cform__status" role="status" aria-live="polite" data-cform-status></p>
  {call && <p class="cform__call">Or call us: <a href={site.phoneHref} class="ulink tap tabular-nums">{site.phone}</a></p>}
</form>

<script>
  // Send the form in the background and answer in place: a thank-you in the form's spot, or the reason it
  // did not go. The Pages Function answers in JSON when asked to.
  document.querySelectorAll<HTMLFormElement>('[data-cform]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-cform-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const phone = form.querySelector<HTMLAnchorElement>('.cform__call a')?.textContent ?? '516.939.2475';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      button.textContent = 'Sending…';
      status.textContent = '';
      status.classList.remove('is-error');
      let ok = false;
      let error = '';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        ok = res.ok && data.ok === true;
        error = data.error ?? '';
      } catch {
        // Offline, or the request never reached us.
      }
      if (ok) {
        form.querySelectorAll('.cform__field, .cform__help, .cform__send').forEach((el) => el.remove());
        status.textContent = 'Thanks, we got your message. We’ll be in touch soon.';
        status.classList.add('is-sent');
        return;
      }
      status.textContent = error || `Sorry, your message did not send. Please try again, or call us at ${phone}.`;
      status.classList.add('is-error');
      button.disabled = false;
      button.textContent = 'Send';
    });
  });
</script>

<style>
  /* No frame of its own: plainly boxed places to type, in line with the page. Where the form sits on a
     photograph, the --cform-* properties turn its words, box edges and focus ring white. */
  .cform {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    background: var(--cform-bg, #fff);
    color: var(--cform-ink, inherit);
  }
  .cform__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2vw, 1.75rem);
    font-weight: 400;
    line-height: 1.2;
    text-wrap: balance;
  }
  .cform__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
  }
  .cform__field:has(textarea) {
    flex: 1;
  }
  .cform label {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .cform input,
  .cform textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.625rem 0.75rem;
    background: #fff;
    border: 1px solid var(--cform-edge, var(--color-control));
    border-radius: 0;
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--color-ink);
    transition: border-color 0.15s ease;
  }
  @media (hover: hover) {
    .cform input:hover,
    .cform textarea:hover {
      border-color: var(--cform-edge, var(--color-ink));
    }
  }
  .cform textarea {
    flex: 1;
    min-height: 4.5rem;
    resize: vertical;
  }
  .cform input:focus-visible,
  .cform textarea:focus-visible {
    outline: 3px solid var(--cform-ring, var(--color-pencil));
    outline-offset: var(--cform-ring-gap, 0);
    border-color: var(--cform-ring, var(--color-pencil));
    box-shadow: none;
  }
  .cform__help {
    margin: 0;
    color: var(--color-muted);
  }
  .cform__send {
    width: 100%;
    font-size: 1.25rem;
  }
  .cform__call {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 0.4em;
    margin: -0.375rem 0;
    font-size: 1.0625rem;
  }
  .cform__call a {
    font-weight: 600;
  }
  .cform__status:empty {
    display: none;
  }
  .cform__status {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .cform__status.is-sent {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    font-weight: 400;
    line-height: 1.3;
  }
  .cform__status.is-error {
    color: var(--cform-error, #a3271c);
  }
  .cform__send:disabled {
    opacity: 0.7;
    cursor: progress;
  }
</style>
