---
import { site, addressLine } from '../lib/site';

interface Props {
  /** Give it a size, e.g. an aspect-ratio class. */
  class?: string;
}
const { class: className } = Astro.props;
// Google's plain embed needs no key. The search names the business, so the pin is the showroom's own listing.
const src = `https://maps.google.com/maps?q=${encodeURIComponent(`${site.name}, ${addressLine}`)}&z=15&output=embed`;
---

<div class:list={['map', className]}>
  <iframe src={src} title={`Map: ${site.name}, ${addressLine}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
</div>

<style>
  .map {
    position: relative;
    background: #e8e7e5;
  }
  .map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
