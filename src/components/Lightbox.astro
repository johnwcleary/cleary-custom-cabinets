---
/**
 * One shared, native <dialog> lightbox. Any <a data-lightbox="group"> (see LightboxLink.astro)
 * opens it. showModal() gives focus containment and Esc; we add arrow keys, focus return and a
 * live caption. No framework island needed. Links work without JS (they open the image).
 */
---

<dialog class="lightbox" data-lightbox-dialog aria-label="Image viewer">
  <figure class="lightbox__figure">
    <!-- <img class="lightbox__img"> is created on first open so the page has no empty-alt image. -->
    <figcaption class="lightbox__caption">
      <span data-lb-label class="lightbox__label"></span>
      <span data-lb-caption></span>
      <span class="lightbox__count" data-lb-count aria-live="polite"></span>
    </figcaption>
  </figure>
  <div class="lightbox__controls">
    <button type="button" class="lightbox__btn lightbox__prev" data-lb-prev aria-label="Previous image">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
    </button>
    <button type="button" class="lightbox__btn lightbox__next" data-lb-next aria-label="Next image">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
    </button>
    <button type="button" class="lightbox__btn lightbox__close" data-lb-close aria-label="Close image viewer">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
    </button>
  </div>
</dialog>

<style is:global>
  /* The lightbox stays on the drawing sheet: paper ground, lettered caption. */
  .lightbox {
    max-width: 100vw;
    max-height: 100dvh;
    width: 100vw;
    height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .lightbox::backdrop {
    background: var(--color-paper);
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
  }
  .lightbox__figure {
    margin: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    place-items: center;
    min-height: 0;
    padding: 3.75rem 1rem 0.5rem;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: saturate(0.92) contrast(1.02);
  }
  .lightbox__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.875rem;
    padding-top: 0.75rem;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }
  .lightbox__count {
    color: var(--color-muted);
  }
  .lightbox__controls {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem 1rem;
  }
  .lightbox__btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: inherit;
    background: transparent;
    border: 1px solid var(--color-ink);
    cursor: pointer;
  }
  .lightbox__btn[hidden] {
    display: none;
  }
  .lightbox__btn:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .lightbox__btn:focus-visible {
    outline: 2px solid var(--color-pencil);
    outline-offset: 2px;
  }
  .lightbox__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
  }
</style>

<script>
  type Item = { src: string; caption: string; label: string; width: string; height: string };

  let items: Item[] = [];
  let index = 0;
  let trigger: HTMLElement | null = null;

  const dialog = () => document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');

  function render() {
    const d = dialog();
    if (!d) return;
    const item = items[index];
    let img = d.querySelector<HTMLImageElement>('[data-lb-img]');
    if (!img) {
      img = document.createElement('img');
      img.className = 'lightbox__img';
      img.dataset.lbImg = '';
      img.decoding = 'async';
      d.querySelector('.lightbox__figure')!.prepend(img);
    }
    img.src = item.src;
    img.alt = item.caption;
    img.width = Number(item.width);
    img.height = Number(item.height);
    d.querySelector('[data-lb-caption]')!.textContent = item.caption;
    d.querySelector('[data-lb-label]')!.textContent = item.label;
    d.querySelector('[data-lb-count]')!.textContent = items.length > 1 ? `${index + 1} / ${items.length}` : '';
    const multi = items.length > 1;
    d.querySelectorAll<HTMLButtonElement>('[data-lb-prev],[data-lb-next]').forEach((b) => (b.hidden = !multi));
    // Warm the cache for the neighbours.
    [index - 1, index + 1].forEach((i) => {
      const n = items[(i + items.length) % items.length];
      if (n) new Image().src = n.src;
    });
  }

  function step(delta: number) {
    if (items.length < 2) return;
    index = (index + delta + items.length) % items.length;
    render();
  }

  function open(links: HTMLAnchorElement[], start: number, from: HTMLElement) {
    const d = dialog();
    if (!d) return;
    items = links.map((a) => ({
      src: a.getAttribute('href')!,
      caption: a.dataset.caption ?? '',
      label: a.dataset.label ?? '',
      width: a.dataset.width ?? '',
      height: a.dataset.height ?? '',
    }));
    index = start;
    trigger = from;
    render();
    d.showModal();
    d.querySelector<HTMLButtonElement>('[data-lb-close]')!.focus();
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const link = target.closest<HTMLAnchorElement>('a[data-lightbox]');
    if (link) {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || (e as MouseEvent).button !== 0) return;
      e.preventDefault();
      const group = link.dataset.lightbox!;
      // A photo can appear twice on a page (featured and in the index); step through it once.
      const seen = new Set<string>();
      const links = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${CSS.escape(group)}"]`)].filter((a) => {
        const href = a.getAttribute('href')!;
        if (seen.has(href)) return false;
        seen.add(href);
        return true;
      });
      open(links, links.findIndex((a) => a.getAttribute('href') === link.getAttribute('href')), link);
      return;
    }
    const d = dialog();
    if (!d?.open) return;
    if (target.closest('[data-lb-prev]')) step(-1);
    else if (target.closest('[data-lb-next]')) step(1);
    else if (target.closest('[data-lb-close]') || target === d) d.close();
  });

  document.addEventListener('keydown', (e) => {
    const d = dialog();
    if (!d?.open) return;
    if (e.key === 'Tab') {
      // Keep focus cycling within the dialog rather than escaping to the browser chrome.
      const focusables = [...d.querySelectorAll<HTMLElement>('button:not([hidden]), [href], [tabindex]:not([tabindex="-1"])')];
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && (active === first || !d.contains(active))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && (active === last || !d.contains(active))) {
        e.preventDefault();
        first.focus();
      }
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      step(-1);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      step(1);
    }
  });

  // Esc fires `cancel` then `close` natively; return focus to the thumbnail that opened us.
  document.addEventListener(
    'close',
    (e) => {
      if (!(e.target as HTMLElement).matches?.('[data-lightbox-dialog]')) return;
      trigger?.focus();
      trigger = null;
    },
    true,
  );
</script>
