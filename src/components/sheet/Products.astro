---
import { Image } from 'astro:assets';
import { getServices, serviceHref, heroCaption, getAllGallery } from '../../lib/content';
import { widthsFor } from '../../lib/img';

const services = await getServices();
const gallery = await getAllGallery();
---

<!-- Seven photos, each named on a white label set in from its corner. The first is double width, which fills the grid evenly. -->
<ul class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-5">
  {
    services.map((s, i) => (
      <li class:list={[i === 0 && 'col-span-2']}>
        <a href={serviceHref(s.data.slug)} class:list={['tile relative block h-full overflow-hidden', i === 0 ? 'aspect-[16/9] lg:aspect-auto' : 'aspect-[4/3]']}>
          <Image src={s.data.heroImage} alt={heroCaption(s, gallery)} widths={widthsFor(s.data.heroImage, [320, 480, 800, 1200])} sizes={i === 0 ? '(min-width: 1024px) 48vw, 100vw' : '(min-width: 1024px) 23vw, 48vw'} class="photo absolute inset-0" />
          <span class:list={['tile__name placard display', i === 0 ? 'text-[1.5rem] lg:text-[1.875rem]' : 'text-[0.9375rem] min-[360px]:text-[1.0625rem] min-[400px]:text-[1.1875rem] sm:text-[1.375rem] lg:text-[1.1875rem] xl:text-[1.5rem]']}>{s.data.shortName ?? s.data.title}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tile__name {
    position: absolute;
    left: var(--inset);
    bottom: var(--inset);
    max-width: calc(100% - 2 * var(--inset));
    --inset: 0.25rem;
    padding: 0.4em 0.6em 0.35em;
    /* A long name breaks before it is ever cut off, however large the reader's text is set. */
    overflow-wrap: anywhere;
    text-decoration: underline transparent;
    text-decoration-thickness: max(2px, 0.07em);
    text-underline-offset: 0.2em;
  }
  .tile:hover .tile__name {
    background: var(--color-ink);
    color: #fff;
    text-decoration-color: currentColor;
  }
  @media (min-width: 360px) {
    .tile__name {
      --inset: 0.5rem;
    }
  }
  @media (min-width: 1024px) {
    .tile__name {
      --inset: 0.75rem;
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tile__name {
      transition: background-color 0.2s ease, color 0.2s ease, text-decoration-color 0.2s ease;
    }
  }
</style>
