---
import { Image } from 'astro:assets';
import { getServices, serviceHref, heroCaption, getAllGallery } from '../../lib/content';
import { widthsFor } from '../../lib/img';

const services = await getServices();
const gallery = await getAllGallery();
---

<!-- Seven photos, each named on the photo itself. The first is double width, which fills the grid evenly. -->
<ul class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4">
  {
    services.map((s, i) => (
      <li class:list={[i === 0 && 'col-span-2']}>
        <a href={serviceHref(s.data.slug)} class:list={['tile relative block h-full overflow-hidden rounded-[4px]', i === 0 ? 'aspect-[16/9] lg:aspect-auto' : 'aspect-[4/3]']}>
          <Image src={s.data.heroImage} alt={heroCaption(s, gallery)} widths={widthsFor(s.data.heroImage, [320, 480, 800, 1200])} sizes={i === 0 ? '(min-width: 1024px) 48vw, 100vw' : '(min-width: 1024px) 23vw, 48vw'} class="photo absolute inset-0" />
          <span class:list={['tile__name caps', i === 0 ? 'text-[1.875rem] lg:text-[2.25rem]' : 'text-[1.375rem] lg:text-[1.625rem]']}>{s.data.shortName ?? s.data.title}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tile__name {
    position: absolute;
    inset: auto 0 0;
    padding: 2.5rem 0.875rem 0.625rem;
    background: linear-gradient(to top, rgb(20 20 22 / 0.7), rgb(20 20 22 / 0.28) 55%, transparent);
    color: var(--color-paper);
    text-shadow: 0 1px 8px rgb(20 20 22 / 0.35);
  }
  .tile:focus-visible {
    outline-offset: 3px;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tile__name {
      transition: padding-bottom 0.25s ease;
    }
    .tile:hover .tile__name {
      padding-bottom: 0.875rem;
    }
  }
</style>
