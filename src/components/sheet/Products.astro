---
import { Image } from 'astro:assets';
import { getServices, serviceHref, heroCaption, getAllGallery } from '../../lib/content';
import { widthsFor } from '../../lib/img';

const services = await getServices();
const gallery = await getAllGallery();
---

<!-- Seven photos, each named on a white tag. The first is double width, which fills the grid evenly. -->
<ul class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-5">
  {
    services.map((s, i) => (
      <li class:list={[i === 0 && 'col-span-2']}>
        <a href={serviceHref(s.data.slug)} class:list={['tile relative block h-full overflow-hidden rounded-[4px]', i === 0 ? 'aspect-[16/9] lg:aspect-auto' : 'aspect-[4/3]']}>
          <Image src={s.data.heroImage} alt={heroCaption(s, gallery)} widths={widthsFor(s.data.heroImage, [320, 480, 800, 1200])} sizes={i === 0 ? '(min-width: 1024px) 48vw, 100vw' : '(min-width: 1024px) 23vw, 48vw'} class="photo absolute inset-0" />
          <span class:list={['tile__name placard caps', i === 0 ? 'text-[1.5rem] lg:text-[1.875rem]' : 'text-[1.1875rem] sm:text-[1.375rem] lg:text-[1.5rem]']}>{s.data.shortName ?? s.data.title}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tile__name {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
    max-width: calc(100% - 1rem);
    padding: 0.3em 0.6em 0.35em;
    text-decoration: underline transparent;
    text-decoration-thickness: max(2px, 0.07em);
    text-underline-offset: 0.2em;
  }
  .tile:hover .tile__name {
    color: var(--color-pencil);
    text-decoration-color: currentColor;
  }
  @media (min-width: 64rem) {
    .tile__name {
      left: 0.75rem;
      bottom: 0.75rem;
      max-width: calc(100% - 1.5rem);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tile__name {
      transition: color 0.2s ease, text-decoration-color 0.2s ease;
    }
  }
</style>
