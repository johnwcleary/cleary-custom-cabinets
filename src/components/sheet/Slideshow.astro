---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getServices, getAllGallery, getPage, heroCaption } from '../../lib/content';
import { widthsFor } from '../../lib/img';

const h = (await getPage('home')).data;
const services = await getServices();
const gallery = await getAllGallery();
const wide = (i: ImageMetadata, min = 1600) => i.width >= min && i.width / i.height >= 1.2;

// The Home hero and any further Home slideshow photos first, then one photo per product: its hero image if that is wide and
// at least 900px across, otherwise its first featured photo that is wide and at least 1600px across.
// All of these are chosen in Storyblok.
type Slide = { image: ImageMetadata; caption: string };
const slides: Slide[] = [{ image: h.heroImage!, caption: h.heroCaption ?? '' }, ...(h.photos ?? [])];
for (const s of services) {
  const own = gallery.filter((g) => g.data.service === s.data.slug && g.data.featured).sort((a, b) => a.data.order - b.data.order);
  const pick = wide(s.data.heroImage, 900) ? { image: s.data.heroImage, caption: heroCaption(s, gallery) } : own.map((g) => ({ image: g.data.image, caption: g.data.caption })).find((g) => wide(g.image));
  if (pick && !slides.some((x) => x.image.src === pick.image.src)) slides.push(pick);
}
---

<div class="show relative aspect-square w-full min-[400px]:aspect-[5/4] overflow-hidden sm:aspect-[16/10] lg:aspect-auto lg:h-full lg:min-h-[26rem]" data-show role="group" aria-roledescription="carousel" aria-label="Photographs of our work">
  {
    slides.map((s, i) => (
      <div class:list={['show__slide', i === 0 && 'is-active']} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} data-slide>
        <Image src={s.image} alt={s.caption} widths={widthsFor(s.image, [800, 1200, 1600, 2000, 2400])} sizes="100vw" class="photo" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
      </div>
    ))
  }
  {
    slides.length > 1 && (
      <div class="show__marks">
        <div class="frame">
          <div class="show__row" role="group" aria-label="Choose a photograph">
            {slides.map((_, i) => <button type="button" class="show__mark" aria-label={`Photograph ${i + 1} of ${slides.length}`} aria-current={i === 0 ? 'true' : undefined} data-show-mark />)}
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .show__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    /* Only the current and next slides are laid out, so the others' photos are not downloaded. */
    display: none;
    transition: opacity 0.9s ease, visibility 0s linear 0.9s;
  }
  .show__slide:global(.is-ready),
  .show__slide:global(.is-active) {
    display: block;
  }
  .show__slide:global(.is-active) {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.9s ease;
  }
  /* One short rule per photo along the foot of the frame, in line with the title above it; the current one is solid.
     The foot of the picture darkens a little behind them, so white shows on any photo. */
  .show__marks {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    padding-top: 2rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.45), rgb(0 0 0 / 0));
    pointer-events: none;
  }
  .show__row {
    display: flex;
    margin-inline: -3px;
  }
  /* Each mark is a button 48px tall; choosing one shows that photo and stops the show there. */
  .show__mark {
    flex: 0 1 3rem;
    min-width: 0;
    height: max(48px, 2.75rem);
    padding: 0 3px;
    display: flex;
    align-items: center;
    pointer-events: auto;
    cursor: pointer;
  }
  .show__mark::before {
    content: '';
    flex: 1;
    height: 4px;
    background: rgb(255 255 255 / 0.5);
  }
  .show__mark:hover::before {
    background: rgb(255 255 255 / 0.8);
  }
  .show__mark[aria-current]::before {
    background: #fff;
  }
  .show__mark:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -6px;
    box-shadow: none;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .show__mark::before {
      transition: background-color 0.2s ease;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .show__slide,
    .show__slide:global(.is-active) {
      transition: none;
    }
  }
</style>

<script>
  const INTERVAL = 5500;
  document.querySelectorAll<HTMLElement>('[data-show]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    if (slides.length < 2) return;
    const marks = [...root.querySelectorAll<HTMLButtonElement>('[data-show-mark]')];

    let current = 0;
    let timer: number | undefined;
    let stopped = matchMedia('(prefers-reduced-motion: reduce)').matches; // the visitor chose a photo, or their settings ask for no motion

    const at = (n: number) => (n + slides.length) % slides.length;
    // Fetch the next photo ahead of time, so a slide never fades in half loaded.
    const prepare = (n: number) => slides[at(n)].classList.add('is-ready');

    async function go(n: number) {
      const next = at(n);
      prepare(next);
      await slides[next].querySelector('img')?.decode().catch(() => {});
      slides[current].classList.remove('is-active');
      slides[next].classList.add('is-active');
      current = next;
      marks.forEach((m, i) => (i === current ? m.setAttribute('aria-current', 'true') : m.removeAttribute('aria-current')));
      if (!stopped) prepare(next + 1);
      schedule();
    }
    function schedule() {
      clearTimeout(timer);
      timer = undefined;
      if (!stopped && !document.hidden) timer = window.setTimeout(() => go(current + 1), INTERVAL);
    }

    // Choosing a photo is also how the show is stopped: it stays on the one chosen.
    marks.forEach((m, i) =>
      m.addEventListener('click', () => {
        stopped = true;
        clearTimeout(timer);
        if (i !== current) go(i);
      }),
    );
    document.addEventListener('visibilitychange', schedule);

    if (!stopped) prepare(1);
    schedule();
  });
</script>
