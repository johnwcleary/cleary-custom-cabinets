---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import LightboxLink from '../LightboxLink.astro';
import { widthsFor } from '../../lib/img';

interface Props {
  image: ImageMetadata;
  caption: string;
  ratio?: string;
  sizes?: string;
  group?: string;
  eager?: boolean;
  /** Keep the caption as alt text and in the lightbox, but don't print it under the photo. */
  hideCaption?: boolean;
  class?: string;
}
const { image, caption, ratio = '4 / 3', sizes = '(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw', group, eager = false, hideCaption = false, class: className } = Astro.props;
const maxWidth = image.width < 1600 ? `max-width: ${Math.round(image.width * 1.35)}px` : undefined;
const style = `aspect-ratio: ${ratio === 'auto' ? `${image.width} / ${image.height}` : ratio}`;
---

<figure class={className} style={maxWidth}>
  {
    group ? (
      <LightboxLink image={image} caption={caption} group={group} class="block">
        <span class="block overflow-hidden rounded-[4px]" style={style}>
          <Image src={image} alt={caption} widths={widthsFor(image)} sizes={sizes} class="photo" loading={eager ? 'eager' : 'lazy'} />
        </span>
      </LightboxLink>
    ) : (
      <span class="block overflow-hidden rounded-[4px]" style={style}>
        <Image src={image} alt={caption} widths={widthsFor(image)} sizes={sizes} class="photo" loading={eager ? 'eager' : 'lazy'} />
      </span>
    )
  }
  {!hideCaption && <figcaption class="mt-2 leading-snug text-muted">{caption}</figcaption>}
</figure>
