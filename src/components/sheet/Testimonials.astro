---
/**
 * Client quotes in boxes on a row that moves along one box at a time: two boxes in view on a wide
 * screen, one on a narrow one. It can also be swiped or moved with the arrow buttons, and stops
 * moving by itself once a visitor does either, or if their settings ask for no motion.
 */
interface Props {
  label?: string;
  items: { quote: string; name: string }[];
}
const { label, items } = Astro.props;
---

<section class="frame section" aria-labelledby="testimonials-title" data-quotes>
  <div class="mb-4 flex items-end justify-between gap-4">
    <h2 id="testimonials-title" class="heading">{label}</h2>
    {
      items.length > 1 && (
        <div class="flex gap-2">
          <button type="button" class="quotes__btn" aria-label="Previous testimonial" data-quotes-prev>
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M11 3 5 9l6 6" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>
          </button>
          <button type="button" class="quotes__btn" aria-label="Next testimonial" data-quotes-next>
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="m7 3 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>
          </button>
        </div>
      )
    }
  </div>
  <ul class="quotes__track" data-quotes-track>
    {
      items.map((t) => (
        <li class="quotes__card">
          <figure class="flex h-full flex-col">
            <blockquote class="space-y-3 text-[1.0625rem] leading-relaxed">
              {t.quote.split(/\n\s*\n/).map((para) => (
                <p>{para}</p>
              ))}
            </blockquote>
            {t.name && <figcaption class="mt-auto pt-4 font-semibold">{t.name}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .quotes__track {
    --gap: clamp(1rem, 2.5vw, 2rem);
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .quotes__track::-webkit-scrollbar {
    display: none;
  }
  .quotes__card {
    flex: 0 0 100%;
    scroll-snap-align: start;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border: 1px solid var(--color-line);
    border-top: 4px solid var(--color-blue);
    background: var(--color-paper);
  }
  @media (min-width: 1024px) {
    .quotes__card {
      flex-basis: calc((100% - var(--gap)) / 2);
    }
  }
  .quotes__btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-control);
    color: var(--color-ink);
  }
  .quotes__btn:hover {
    background: var(--color-blue);
    border-color: var(--color-blue);
    color: #fff;
  }
  .quotes__btn:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .quotes__track {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  const INTERVAL = 7000;
  document.querySelectorAll<HTMLElement>('[data-quotes]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-quotes-track]')!;
    const cards = [...track.children] as HTMLElement[];
    if (cards.length < 2) return;

    let timer: number | undefined;
    let stopped = matchMedia('(prefers-reduced-motion: reduce)').matches; // the visitor took over, or their settings ask for no motion
    let paused = false; // the pointer or keyboard focus is on the quotes

    // How far a card is from the row's left edge, and how many cards fit in view at once.
    const offset = (c: HTMLElement) => c.getBoundingClientRect().left - track.getBoundingClientRect().left;
    const perView = () => Math.max(1, Math.round(track.clientWidth / cards[0].offsetWidth));
    const last = () => cards.length - perView();
    // The card at the left of the view. Set when moving, and read back from the row once a swipe settles.
    let index = 0;
    let settle: number | undefined;
    track.addEventListener('scroll', () => {
      clearTimeout(settle);
      settle = window.setTimeout(() => {
        index = cards.reduce((best, c, i) => (Math.abs(offset(c)) < Math.abs(offset(cards[best])) ? i : best), 0);
      }, 150);
    });

    function go(n: number) {
      // Past either end it wraps round to the other.
      index = n > last() ? 0 : n < 0 ? last() : n;
      track.scrollTo({ left: track.scrollLeft + offset(cards[index]) });
    }
    function schedule() {
      clearTimeout(timer);
      timer = undefined;
      if (!stopped && !paused && !document.hidden) timer = window.setTimeout(() => (go(index + 1), schedule()), INTERVAL);
    }
    const takeOver = () => {
      stopped = true;
      clearTimeout(timer);
    };

    root.querySelector('[data-quotes-prev]')?.addEventListener('click', () => (takeOver(), go(index - 1)));
    root.querySelector('[data-quotes-next]')?.addEventListener('click', () => (takeOver(), go(index + 1)));
    track.addEventListener('pointerdown', takeOver);
    track.addEventListener('wheel', (e) => Math.abs(e.deltaX) > Math.abs(e.deltaY) && takeOver(), { passive: true });
    root.addEventListener('pointerenter', () => ((paused = true), schedule()));
    root.addEventListener('pointerleave', () => ((paused = false), schedule()));
    root.addEventListener('focusin', () => ((paused = true), schedule()));
    root.addEventListener('focusout', () => ((paused = false), schedule()));
    document.addEventListener('visibilitychange', schedule);
    schedule();
  });
</script>
