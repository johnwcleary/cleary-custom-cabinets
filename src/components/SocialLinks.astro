---
import { site } from '../lib/site';

interface Props {
  class?: string;
  /** Show the network name next to the icon. */
  labels?: boolean;
}
const { class: className, labels = false } = Astro.props;

const links = [
  {
    name: 'Instagram',
    href: site.social.instagram,
    // Exact geometry: rounded square r5.5 with a 2-unit wall, lens ring and flash dot (even-odd holes).
    path: 'M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7.25a4.75 4.75 0 1 1 0 9.5 4.75 4.75 0 0 1 0-9.5Zm0 2a2.75 2.75 0 1 0 0 5.5 2.75 2.75 0 0 0 0-5.5Zm5.25-3.75a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z',
  },
  {
    name: 'Facebook',
    href: site.social.facebook,
    path: 'M13.4 21.9v-7.4h2.5l.4-2.9h-2.9V9.8c0-.8.2-1.4 1.4-1.4h1.6V5.8c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.1H8v2.9h2.5v7.4h2.9Z',
  },
  {
    name: 'Houzz',
    href: site.social.houzz,
    path: 'M14.6 22h5.6V10.6L8.9 7.4V2H3.8v20h5.6v-6.2h5.2V22Z',
  },
];
---

<ul class={className} data-social>
  {
    links.map((l) => (
      <li>
        <a href={l.href} rel="noopener" aria-label={labels ? undefined : `${site.name} on ${l.name}`}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="currentColor">
            <path d={l.path} fill-rule="evenodd" />
          </svg>
          {labels && <span>{l.name}</span>}
        </a>
      </li>
    ))
  }
</ul>
