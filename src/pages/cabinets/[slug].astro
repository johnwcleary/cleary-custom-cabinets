---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import LightboxLink from '../../components/LightboxLink.astro';
import Fig from '../../components/sheet/Fig.astro';
import { getServices, getGallery, getPage, splitFeatured, heroCaption, getAllGallery, type Service } from '../../lib/content';
import { widthsFor } from '../../lib/img';
import { site } from '../../lib/site';

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.data.slug }, props: { service } }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
}
const { service } = Astro.props;
const s = service.data;
const h = (await getPage('home')).data;
const items = await getGallery(s.slug);
const all = await getAllGallery();
const { featured, rest: others } = splitFeatured(items, s.heroImage.src);
const [hero, ...rest] = featured;
const heroAlt = heroCaption(service, all);
---

<BaseLayout title={s.seoTitle} image={s.heroImage}>
  <section class="frame section grid grid-cols-1 items-center gap-4 lg:grid-cols-[minmax(0,5fr)_minmax(0,8fr)] lg:gap-8" aria-labelledby="page-title">
    <div>
      <h1 id="page-title" class="page-title mb-3">{s.title}</h1>
      {s.intro && <p class="lead mb-4">{s.intro}</p>}
      {h.showroomButton && <a href="#appointment" class="btn">{h.showroomButton}</a>}
    </div>
    {
      hero ? (
        <Fig image={hero.data.image} caption={hero.data.caption} ratio="3 / 2" group={s.slug} eager sizes="(min-width: 1024px) 58vw, 92vw" class="mx-auto w-full" />
      ) : (
        <Fig image={s.heroImage} caption={heroAlt} ratio="3 / 2" eager sizes="(min-width: 1024px) 58vw, 92vw" class="mx-auto w-full" />
      )
    }
  </section>

  {
    rest.length > 0 && (
      <section class="frame pb-[clamp(1.25rem,2.4vw,2.25rem)]" aria-label={`${s.title}: featured photographs`}>
        <ul class="grid grid-cols-1 gap-x-3 gap-y-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-4">
          {rest.map((g) => <li><Fig image={g.data.image} caption={g.data.caption} group={s.slug} class="mx-auto" /></li>)}
        </ul>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section class="frame pb-[clamp(1.25rem,2.4vw,2.25rem)]" aria-labelledby="collection-title">
        <h2 id="collection-title" class="heading mb-3">More from the collection</h2>
        <!-- A wall of photographs. Each one's caption is its alt text and shows when the photo is opened. -->
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 lg:gap-4">
          {others.map((g) => (
            <li>
              <LightboxLink image={g.data.image} caption={g.data.caption} group={s.slug} class="block aspect-[4/3] overflow-hidden">
                <Image src={g.data.image} alt={g.data.caption} widths={widthsFor(g.data.image, [320, 560, 800])} sizes="(min-width: 1024px) 23vw, (min-width: 640px) 30vw, 45vw" class="photo" />
              </LightboxLink>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="frame section grid grid-cols-1 items-center gap-5 lg:grid-cols-[minmax(0,1fr)_25rem] lg:gap-10 xl:grid-cols-[minmax(0,1fr)_27rem]" aria-label="In closing">
    <div>
      <p class="closing mb-3">{s.closing || site.tagline}</p>
      {s.closingAside && <p class="measure mb-2 text-muted">{s.closingAside}</p>}
      {s.video && <p><a href={s.video.url} rel="noopener" class="ulink tap">{s.video.title}</a> <span class="text-muted">(video)</span></p>}
    </div>
    <div id="appointment">
      <ContactForm heading={h.contactHeading} />
    </div>
  </section>
</BaseLayout>
