---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LightboxLink from '../../components/LightboxLink.astro';
import Fig from '../../components/hearth/Fig.astro';
import { getServices, getGallery, neighbours, serviceHref, splitFeatured, heroCaption, getAllGallery, type Service } from '../../lib/content';
import { widthsFor } from '../../lib/img';
import { site } from '../../lib/site';

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.data.slug }, props: { service, services } }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
  services: Service[];
}
const { service, services } = Astro.props;
const s = service.data;
const items = await getGallery(s.slug);
const all = await getAllGallery();
const { prev, next } = neighbours(services, s.slug);
const { featured, rest: others } = splitFeatured(items, s.heroImage.src);
const [hero, ...rest] = featured;
const heroAlt = heroCaption(service, all);
const leadImage = hero?.data.image ?? s.heroImage;
// Small source photos (medical reception, the quick-ship renders) can't go full-bleed.
const fullBleed = leadImage.width >= 1400;
const hasClosing = !!(s.closing || s.closingAside || s.video);
// Editorial rhythm: mostly 4:5, every third image 3:2.
const ratioFor = (i: number) => (i % 3 === 1 ? '3 / 2' : '4 / 5');
---

<BaseLayout title={s.seoTitle} image={s.heroImage}>
  {fullBleed ? (
  <section class="relative isolate" aria-labelledby="page-title">
    <figure class="relative h-[48svh] min-h-[20rem] w-full md:h-[58svh]">
      {
        hero ? (
          <LightboxLink image={hero.data.image} caption={hero.data.caption} group={s.slug} class="absolute inset-0 block">
            <Image src={hero.data.image} alt={hero.data.caption} widths={widthsFor(hero.data.image, [800, 1200, 1600, 2000])} sizes="100vw" class="photo absolute inset-0" loading="eager" fetchpriority="high" />
          </LightboxLink>
        ) : (
          <Image src={s.heroImage} alt={heroAlt} widths={widthsFor(s.heroImage, [800, 1200, 1600, 2000])} sizes="100vw" class="photo absolute inset-0" loading="eager" />
        )
      }
      <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-walnut/85 via-walnut/25 to-walnut/0" aria-hidden="true"></span>
      <figcaption class="smallcaps pointer-events-none absolute right-4 bottom-4 text-linen/85 md:right-8 md:bottom-6">{hero?.data.caption ?? heroAlt}</figcaption>
    </figure>
    <div class="wrap pointer-events-none absolute inset-x-0 bottom-0 pb-12 text-linen md:pb-16">
      <p class="meta mb-4"><a href="/#services" class="pointer-events-auto hover:underline">Cabinets &amp; products</a> <span aria-hidden="true">●</span> {items.length} photographs</p>
      <h1 id="page-title" class="hero-title max-w-[16ch] !text-[clamp(2.25rem,5vw,4.5rem)]">{s.title}</h1>
    </div>
  </section>
  ) : (
    <section class="wrap pt-[clamp(2rem,4vw,3.5rem)]" aria-labelledby="page-title">
      <div class="grid grid-cols-1 items-end gap-10 md:grid-cols-12">
        <div class="md:col-span-5">
          <p class="meta mb-5 text-muted"><a href="/#services" class="hover:underline">Cabinets &amp; products</a> <span aria-hidden="true">●</span> {items.length} photographs</p>
          <h1 id="page-title" class="title">{s.title}</h1>
        </div>
        <div class="md:col-span-6 md:col-start-7">
          {hero ? (
            <Fig image={hero.data.image} caption={hero.data.caption} ratio="auto" group={s.slug} eager sizes="(min-width: 768px) 45vw, 92vw" class="ml-auto" />
          ) : (
            <Fig image={s.heroImage} caption={heroAlt} ratio="auto" eager sizes="(min-width: 768px) 45vw, 92vw" class="ml-auto" />
          )}
        </div>
      </div>
    </section>
  )}

  {
    s.intro && (
      <section class="py-[clamp(2.25rem,4.5vw,3.75rem)] text-center" aria-label="Introduction">
        <div class="wrap">
          <p class="say-sm mx-auto max-w-[40ch]">{s.intro}</p>
        </div>
      </section>
    )
  }

  <section class:list={['wrap', !s.intro && 'pt-[clamp(2.25rem,4.5vw,3.75rem)]', !hasClosing && 'pb-[clamp(2.25rem,4.5vw,3.75rem)]']} aria-label={`${s.title}: featured photographs`}>
    <div class:list={rest.length > 6 ? 'columns-1 gap-x-[clamp(1rem,2vw,1.75rem)] sm:columns-2 lg:columns-3' : 'grid grid-cols-1 gap-x-[clamp(1rem,2vw,1.75rem)] sm:grid-cols-2 lg:grid-cols-3'}>
      {
        rest.map((g, i) => (
          <Fig
            image={g.data.image}
            caption={g.data.caption}
            ratio={rest.length > 6 ? ratioFor(i) : '4 / 5'}
            group={s.slug}
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
            class:list={['mb-[clamp(1.5rem,2.5vw,2.25rem)] break-inside-avoid']}
          />
        ))
      }
    </div>
  </section>

  {
    (s.closing || s.closingAside || s.video) && (
      <section class="py-[clamp(2.5rem,5vw,4.5rem)] text-center" aria-label="In closing">
        <div class="wrap">
          {s.closing && <p class="say-sm mx-auto max-w-[40ch]">{s.closing}</p>}
          {s.closingAside && <p class="serif mt-6 text-2xl text-cherry italic">{s.closingAside}</p>}
          {s.video && (
            <p class="mt-8 text-sm">
              <span class="meta mr-2 text-muted">Video</span>
              <a href={s.video.url} rel="noopener" class="ulink">{s.video.title}</a> <span class="text-muted">(Vimeo)</span>
            </p>
          )}
          <p class="mt-7 flex flex-wrap justify-center gap-3">
            <a href="/contact" class="btn">Make a showroom appointment</a>
            <a href={site.phoneHref} class="btn btn-ghost hover:!border-ink hover:!bg-ink hover:!text-linen">{site.phone}</a>
          </p>
        </div>
      </section>
    )
  }

  {others.length > 0 && (
  <section class="bg-oat band" aria-labelledby="collection-title">
    <div class="wrap">
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-4 border-b border-line pb-3">
        <h2 id="collection-title" class="say-sm">More from the collection</h2>
        <p class="meta text-muted">{others.length} more photographs</p>
      </div>
      <ul class="grid grid-cols-2 gap-x-3 gap-y-5 sm:grid-cols-3 lg:grid-cols-5 lg:gap-x-5 lg:gap-y-7">
        {
          others.map((g) => (
            <li>
              <LightboxLink image={g.data.image} caption={g.data.caption} group={s.slug} class="coll group block">
                <span class="block aspect-[3/2] overflow-hidden">
                  <Image src={g.data.image} alt={g.data.caption} widths={widthsFor(g.data.image, [320, 560])} sizes="(min-width: 1024px) 18vw, (min-width: 640px) 30vw, 45vw" class="photo coll__img" />
                </span>
                <span class="smallcaps mt-2 block text-sm text-muted group-hover:text-ink">{g.data.caption}</span>
              </LightboxLink>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  )}

  <nav aria-label="More cabinets and products">
    <ul class="grid grid-cols-1 sm:grid-cols-2">
      {
        [
          { svc: prev, rel: 'prev', dir: 'Previous' },
          { svc: next, rel: 'next', dir: 'Next' },
        ].map(({ svc, rel, dir }) => (
          <li>
            <a href={serviceHref(svc.data.slug)} rel={rel} class="pn group relative block overflow-hidden">
              <span class="block aspect-[21/9] sm:aspect-[16/9] lg:aspect-[21/9]">
                <Image src={svc.data.heroImage} alt={heroCaption(svc, all)} widths={widthsFor(svc.data.heroImage, [480, 800, 1200])} sizes="(min-width: 640px) 50vw, 100vw" class="photo pn__img" />
              </span>
              <span class="absolute inset-0 bg-walnut/60 group-hover:bg-walnut/72" aria-hidden="true" />
              <span class="absolute inset-0 flex flex-col items-center justify-center text-center text-linen">
                <span class="meta mb-3">{dir}</span>
                <span class="serif text-5xl">{svc.data.shortName ?? svc.data.title}</span>
                <span class="meta mt-3 opacity-90">{svc.data.title}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>

<style>
  .pn:focus-visible {
    outline-offset: -4px;
    outline-color: var(--color-linen);
  }
  @media (prefers-reduced-motion: no-preference) {
    .coll__img,
    .pn__img {
      transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .coll:hover .coll__img,
    .coll:focus-visible .coll__img,
    .pn:hover .pn__img,
    .pn:focus-visible .pn__img {
      transform: scale(1.04);
    }
  }
</style>
