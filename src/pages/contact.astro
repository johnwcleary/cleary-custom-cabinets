---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getPage } from '../lib/content';

const contact = await getPage('contact');
---

<BaseLayout title={contact.data.seoTitle}>
  <section class="frame section" aria-labelledby="page-title">
    <!-- Only the form, in the middle of the page: the address, phone, email and hours are in the footer just below. -->
    <div class="mx-auto max-w-[32rem]">
      <h1 id="page-title" class="page-title mb-2 text-center">Contact us</h1>
      <p class="lead mb-5 text-center">{contact.data.lead}</p>
      <div id="appointment">
        <ContactForm helper={contact.data.formHelper} />
      </div>
    </div>
  </section>
</BaseLayout>
