---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Hours from '../components/Hours.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Fig from '../components/hearth/Fig.astro';
import { getPage } from '../lib/content';
import { site } from '../lib/site';

const contact = await getPage('contact');
const about = await getPage('about');
const showroom = (about.data.photos ?? []).filter((p) => p.caption.startsWith('Our Showroom'))[2];
---

<BaseLayout title={contact.data.seoTitle}>
  <section class="band" aria-labelledby="page-title">
    <div class="wrap grid grid-cols-1 gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="meta mb-6 text-muted">Contact</p>
        <h1 id="page-title" class="title mb-8">Contact us</h1>
        <p class="say-sm mb-12 max-w-[26ch]">{contact.data.lead}</p>

        <dl class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          <div>
            <dt class="meta mb-2 text-muted">Find us:</dt>
            <dd>
              <a href={site.mapsUrl} rel="noopener" class="ulink">{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</a>
            </dd>
          </div>
          <div>
            <dt class="meta mb-2 text-muted">Call &amp; write</dt>
            <dd>
              <a href={site.phoneHref} class="serif text-3xl tabular-nums hover:text-cherry">{site.phone}</a><br />
              <a href={`mailto:${site.email}`} class="ulink break-all">{site.email}</a>
            </dd>
          </div>
          <div>
            <dt class="meta mb-2 text-muted">Follow us:</dt>
            <dd><SocialLinks labels class="social-list flex flex-col gap-1.5" /></dd>
          </div>
          <div>
            <dt class="meta mb-2 text-muted">Service area</dt>
            <dd>{site.serviceArea}</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div class="bg-oat p-6 sm:p-10">
          <ContactForm helper={contact.data.formHelper} />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-oat" aria-labelledby="hours-title">
    <div class="wrap grid grid-cols-1 items-center gap-12 py-16 md:grid-cols-12 md:py-24">
      {showroom && <Fig image={showroom.image} caption={showroom.caption} ratio="4 / 5" group="contact" sizes="(min-width: 768px) 30vw, 90vw" class="md:col-span-4" />}
      <div class="md:col-span-6 md:col-start-6">
        <h2 id="hours-title" class="meta mb-6 text-muted">Showroom hours</h2>
        <p class="say mb-10">Make a showroom appointment for the quality and service you deserve.</p>
        <Hours class="hours-table max-w-md" />
      </div>
    </div>
  </section>
</BaseLayout>
