---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Products from '../components/sheet/Products.astro';
import Slideshow from '../components/sheet/Slideshow.astro';
import Fig from '../components/sheet/Fig.astro';
import { getPage } from '../lib/content';
import { site } from '../lib/site';
import { widthsFor } from '../lib/img';
import { swatch } from '../lib/materials';
import kitchenDrawing from '../assets/drawings/kitchen-elevation.png';
import receptionDrawing from '../assets/drawings/reception-desk-elevation.png';
import vanityDrawing from '../assets/drawings/vanity-shop-drawing.png';

const home = await getPage('home');
const about = await getPage('about');
const showroom = (about.data.photos ?? []).find((p) => p.caption.startsWith('Our Showroom'))!;
const shop = (about.data.photos ?? []).find((p) => p.caption.startsWith('Our Shop'))!;
// Every section's text is edited on the Home page in Storyblok (pages/home.md).
const h = home.data;
// Real drawings from the shop, recoloured to white line (transparent PNG) so they sit on the blue panel.
// Each sits in a box the shape of the kitchen drawing, so the taller ones come out the same height as it.
const drawings = [
  { src: kitchenDrawing, alt: 'Elevation drawing of a kitchen range wall' },
  { src: receptionDrawing, alt: 'Elevation drawing of a reception desk' },
  { src: vanityDrawing, alt: 'Shop drawing of a vanity wall with towers' },
];
const groups = [
  { heading: h.cabinetryHeading, group: 'cabinet' as const, items: h.cabinetryMaterials ?? [], span: 'xl:col-span-3' },
  { heading: h.countertopsHeading, group: 'counter' as const, items: h.countertopsMaterials ?? [], span: 'xl:col-span-7' },
];
---

<BaseLayout title={home.data.seoTitle}>
  <section class="pb-[clamp(0.5rem,1vw,1rem)]" aria-labelledby="home-title">
    <!-- The photo runs from one edge of the screen to the other. The title and a button to the contact page sit on a blue
         panel: on its lower left on a wide screen, under it on a narrower one. -->
    <div class="hero relative">
      <div class="hero-photo relative min-w-0 lg:grid">
        <Slideshow />
      </div>
      <div class="hero-panel on-blue">
        <h1 id="home-title" class="hero-title">{h.heroTitle}</h1>
        <p class="hero-sub mt-2">{h.heroSubtitle}</p>
        {h.showroomButton && <p class="mt-6"><a href="/contact" class="btn btn-white btn-lg max-sm:w-full">{h.showroomButton}</a></p>}
      </div>
    </div>
  </section>

  <section id="services" class="frame section" aria-labelledby="services-title">
    <h2 id="services-title" class="heading mb-3">{h.cabinetsLabel}</h2>
    <Products />
  </section>

  <!-- A blue panel with three of the shop's drawings in white line. -->
  <section class="frame section" aria-labelledby="about-title">
    <div class="blueprint on-blue grid grid-cols-1 items-center gap-5 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-10">
      <div>
        <h2 id="about-title" class="heading mb-3">{h.aboutLabel}</h2>
        {h.aboutHeading && <p class="lead mb-2.5">{h.aboutHeading}</p>}
        {h.aboutText && <p class="measure mb-1.5 text-blue-pale">{h.aboutText}</p>}
        {h.aboutButton && <p><a href="/about" class="ulink tap font-semibold">{h.aboutButton}</a></p>}
      </div>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-5">
        {
          site.services.map((name, i) => (
            <li class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] items-center gap-4 sm:block">
              {drawings[i] && (
                <span class="block aspect-[862/461] sm:mb-2">
                  <Image src={drawings[i].src} alt={drawings[i].alt} widths={widthsFor(drawings[i].src, [320, 640, 900])} sizes="(min-width: 1024px) 16vw, (min-width: 640px) 28vw, 36vw" class="h-full w-full object-contain object-left-bottom" />
                </span>
              )}
              <span class="display block max-w-[11ch] text-[1.25rem] lg:text-[1.375rem]">{name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="frame section" aria-labelledby="materials-title">
    <h2 id="materials-title" class="heading mb-3">{h.materialsLabel}</h2>
    <!-- One row of ten equal samples on a wide screen; two groups, one above the other, on anything narrower. -->
    <div class="grid grid-cols-1 gap-5 xl:grid-cols-10 xl:gap-x-4 xl:gap-y-0">
      {
        groups.map((g) => (
          <div class:list={['xl:grid xl:grid-cols-subgrid', g.span]}>
            <h3 class="mb-2 text-[1.125rem] font-semibold xl:col-span-full">{g.heading}</h3>
            <ul class="grid grid-cols-3 gap-x-3 gap-y-3 sm:grid-cols-4 lg:grid-cols-7 xl:col-span-full xl:grid-cols-subgrid xl:gap-x-4">
              {g.items.map((m) => {
                const img = swatch(m, g.group);
                return (
                  <li>
                    {img && (
                      <span class="swatch mb-1.5 block aspect-square overflow-hidden">
                        <Image src={img} alt={`${m} ${g.heading?.toLowerCase() ?? ''}`.trim()} widths={widthsFor(img, [240, 400, 600])} sizes="(min-width: 1280px) 8vw, (min-width: 1024px) 12vw, (min-width: 640px) 22vw, 30vw" class="photo" />
                      </span>
                    )}
                    <span class="block leading-snug [overflow-wrap:anywhere]">{m}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="frame section grid grid-cols-1 items-center gap-5 lg:grid-cols-2 lg:gap-10" aria-labelledby="showroom-title">
    <div class="grid grid-cols-2 items-start gap-3 lg:gap-5">
      <Fig image={showroom.image} caption={showroom.caption} ratio="4 / 5" group="home-visit" hideCaption sizes="(min-width: 1024px) 24vw, 46vw" />
      <Fig image={shop.image} caption={shop.caption} ratio="4 / 5" group="home-visit" hideCaption sizes="(min-width: 1024px) 24vw, 46vw" />
    </div>
    <div>
      <h2 id="showroom-title" class="heading mb-3">{h.showroomLabel}</h2>
      {h.showroomText && <p class="lead mb-1.5">{h.showroomText}</p>}
      <p class="mb-3"><a href={site.mapsUrl} rel="noopener" class="ulink tap">{site.address.street}, {site.address.city}, {site.address.state} {site.address.zip}</a></p>
      {h.showroomButton && <a href="/contact" class="btn">{h.showroomButton}</a>}
    </div>
  </section>

  {
    h.testimonials && h.testimonials.length > 0 && (
      <section class="frame section" aria-labelledby="testimonials-title">
        <h2 id="testimonials-title" class="heading mb-4">{h.testimonialsLabel}</h2>
        <!-- Each quote under a blue rule, two to a row on a wide screen. A blank line in the quote starts a new paragraph. -->
        <ul class="grid grid-cols-1 gap-x-10 gap-y-8 lg:grid-cols-2">
          {h.testimonials.map((t) => (
            <li class="border-t-2 border-blue pt-4">
              <figure>
                <blockquote class="measure space-y-3 text-[1.0625rem] leading-relaxed">
                  {t.quote.split(/\n\s*\n/).map((para) => <p>{para}</p>)}
                </blockquote>
                {t.name && <figcaption class="mt-3 font-semibold">{t.name}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
