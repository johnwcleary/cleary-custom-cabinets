---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Products from '../components/sheet/Products.astro';
import Slideshow from '../components/sheet/Slideshow.astro';
import Fig from '../components/sheet/Fig.astro';
import Drawing from '../components/sheet/Drawing.astro';
import { getPage } from '../lib/content';
import { site } from '../lib/site';
import { widthsFor } from '../lib/img';
import { swatch } from '../lib/materials';

const home = await getPage('home');
const about = await getPage('about');
const showroom = (about.data.photos ?? []).find((p) => p.caption.startsWith('Our Showroom'))!;
const shop = (about.data.photos ?? []).find((p) => p.caption.startsWith('Our Shop'))!;
// Every section's text is edited on the Home page in Storyblok (pages/home.md).
const h = home.data;
const drawings = ['elevation', 'commercial', 'cabinet'] as const;
const groups = [
  { heading: h.cabinetryHeading, group: 'cabinet' as const, items: h.cabinetryMaterials ?? [], cols: 'grid-cols-3' },
  { heading: h.countertopsHeading, group: 'counter' as const, items: h.countertopsMaterials ?? [], cols: 'grid-cols-3 sm:grid-cols-4 lg:grid-cols-7' },
];
---

<BaseLayout title={home.data.seoTitle}>
  <section class="frame pt-3 pb-[clamp(1rem,2vw,1.75rem)] lg:pt-4" aria-labelledby="home-title">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_26rem] lg:gap-5 xl:grid-cols-[minmax(0,1fr)_27rem]">
      <div class="hero-col relative min-w-0">
        <Slideshow />
        <!-- The title sits on the photo; clicks and hovers pass through to the slideshow. -->
        <div class="hero-overlay pointer-events-none absolute inset-x-0 bottom-0 rounded-b-[6px] px-4 pt-16 pb-4 text-paper lg:px-6 lg:pb-5">
          <h1 id="home-title" class="hero-title">{h.heroTitle}</h1>
          <p class="lead mt-1 italic !text-[min(4.6cqw,1.5rem)]">{h.heroSubtitle}</p>
        </div>
      </div>
      <div id="appointment">
        <ContactForm heading={h.contactHeading} />
      </div>
    </div>
  </section>

  <section id="services" class="frame section" aria-labelledby="services-title">
    <h2 id="services-title" class="heading mb-3">{h.cabinetsLabel}</h2>
    <Products />
  </section>

  <section class="frame section grid grid-cols-1 items-center gap-5 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-10" aria-labelledby="about-title">
    <div>
      <h2 id="about-title" class="heading mb-3">{h.aboutLabel}</h2>
      {h.aboutHeading && <p class="lead mb-2.5">{h.aboutHeading}</p>}
      {h.aboutText && <p class="mb-3 max-w-[52ch] text-muted">{h.aboutText}</p>}
      {h.aboutButton && <p><a href="/about" class="ulink">{h.aboutButton}</a></p>}
    </div>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-5">
      {
        site.services.map((name, i) => (
          <li class="svc grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] items-center gap-4 sm:block">
            {drawings[i] && <Drawing kind={drawings[i]} class="sm:mb-2" />}
            <span class="caps block text-[1.375rem] lg:text-[1.625rem]">{name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="frame section" aria-labelledby="materials-title">
    <h2 id="materials-title" class="heading mb-3">{h.materialsLabel}</h2>
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-[3fr_7fr] lg:gap-4">
      {
        groups.map((g) => (
          <div>
            <h3 class="mb-2 text-[1.125rem] font-semibold">{g.heading}</h3>
            <ul class:list={['grid gap-2', g.cols]}>
              {g.items.map((m) => {
                const img = swatch(m, g.group);
                return (
                  <li>
                    {img && (
                      <span class="swatch mb-1 block aspect-square overflow-hidden rounded-[4px]">
                        <Image src={img} alt={`${m} ${g.heading?.toLowerCase() ?? ''}`.trim()} widths={widthsFor(img, [240, 400, 600])} sizes="(min-width: 1024px) 12vw, 30vw" class="photo" />
                      </span>
                    )}
                    <span class="block leading-snug">{m}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="frame section grid grid-cols-1 items-center gap-5 lg:grid-cols-2 lg:gap-10" aria-labelledby="showroom-title">
    <div class="grid grid-cols-2 items-start gap-3">
      <Fig image={showroom.image} caption={showroom.caption} ratio="4 / 5" group="home-visit" sizes="(min-width: 1024px) 24vw, 46vw" />
      <Fig image={shop.image} caption={shop.caption} ratio="4 / 5" group="home-visit" sizes="(min-width: 1024px) 24vw, 46vw" />
    </div>
    <div>
      <h2 id="showroom-title" class="heading mb-3">{h.showroomLabel}</h2>
      {h.showroomText && <p class="lead mb-3">{h.showroomText}</p>}
      <p class="mb-4"><a href={site.mapsUrl} rel="noopener" class="ulink">{site.address.street}, {site.address.city}, {site.address.state} {site.address.zip}</a></p>
      {h.showroomButton && <a href="#appointment" class="btn">{h.showroomButton}</a>}
    </div>
  </section>
</BaseLayout>
