---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Hours from '../components/Hours.astro';
import Products from '../components/sheet/Products.astro';
import SheetHead from '../components/sheet/SheetHead.astro';
import Drawing from '../components/sheet/Drawing.astro';
import Hatch from '../components/sheet/Hatch.astro';
import Fig from '../components/sheet/Fig.astro';
import { getPage } from '../lib/content';
import { site } from '../lib/site';
import { pad2, widthsFor } from '../lib/img';

const home = await getPage('home');
const about = await getPage('about');
const showroom = (about.data.photos ?? []).find((p) => p.caption.startsWith('Our Showroom'))!;
const shop = (about.data.photos ?? []).find((p) => p.caption.startsWith('Our Shop'))!;
const hero = home.data.heroImage!;
// Every section's text is edited on the Home page in Storyblok (pages/home.md).
const h = home.data;
const drawings = ['elevation', 'plan', 'door'] as const;
const legend = [
  { heading: h.cabinetryHeading, code: 'A', items: h.cabinetryMaterials ?? [] },
  { heading: h.countertopsHeading, code: 'B', items: h.countertopsMaterials ?? [] },
];
---

<BaseLayout title={home.data.seoTitle}>
  <div class="frame">
    <section aria-labelledby="home-title">
      <div class="wrap pt-3 pb-2.5 lg:pt-4">
        <h1 id="home-title" class="hero-title">{h.heroTitle}</h1>
        <div class="mt-1.5 flex flex-wrap items-center gap-x-6 gap-y-1">
          <p class="display text-[1.3125rem] lg:text-[1.5rem]">{h.heroSubtitle}</p>
          <p class="dim mono hidden flex-1 lg:flex"><span class="shrink-0">{site.serviceArea}</span></p>
        </div>
      </div>
      <div class="hero-row grid grid-cols-1 border-t border-ink lg:grid-cols-[minmax(0,1fr)_31rem]">
        <figure class="flex min-w-0 flex-col p-3 lg:p-4">
          <span class="ticked min-h-0 flex-1">
            <span class="relative block aspect-[16/9] h-full w-full lg:aspect-auto">
              <Image src={hero} alt={h.heroCaption ?? ''} widths={widthsFor(hero, [800, 1200, 1600, 2000])} sizes="(min-width: 1024px) 66vw, 100vw" class="photo absolute inset-0" loading="eager" fetchpriority="high" />
            </span>
          </span>
          <figcaption class="mono mt-1.5 flex gap-2.5 px-2 text-muted"><span class="text-ink">Fig. 1</span><span>{h.heroCaption}</span></figcaption>
        </figure>
        <div id="appointment" class="border-t border-ink lg:border-t-0 lg:border-l">
          <ContactForm label={h.contactLabel} heading={h.contactHeading} button={h.showroomButton} />
        </div>
      </div>
    </section>

    <section id="services" class="sheet" aria-labelledby="services-title">
      <SheetHead no="01" id="services-title">{h.cabinetsLabel}</SheetHead>
      <Products />
    </section>

    <section class="sheet" aria-labelledby="about-title">
      <SheetHead no="02" id="about-title">{h.aboutLabel}</SheetHead>
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,9fr)]">
        <div class="wrap py-6 lg:py-8">
          {h.aboutHeading && <p class="lead mb-4 max-w-[30ch]">{h.aboutHeading}</p>}
          {h.aboutText && <p class="mb-6 max-w-[46ch] text-muted">{h.aboutText}</p>}
          {h.aboutButton && <p><a href="/about" class="btn btn-ghost">{h.aboutButton} <span aria-hidden="true">→</span></a></p>}
        </div>
        <ol class="ruled grid grid-cols-1 border-t border-line sm:grid-cols-3 lg:border-t-0 lg:border-l">
          {
            site.services.map((name, i) => (
              <li class="grid grid-cols-[minmax(0,5fr)_minmax(0,6fr)] items-center gap-x-4 p-3 sm:flex sm:flex-col sm:items-stretch lg:p-4">
                {drawings[i] && <Drawing kind={drawings[i]} class="row-span-2 sm:order-2 sm:mt-auto sm:mb-4" />}
                <span class="mono self-end text-muted sm:order-1 sm:mb-3 sm:flex sm:self-auto">
                  <span>{pad2(i + 1)}</span>
                  {i < site.services.length - 1 && <span class="ml-auto hidden sm:inline" aria-hidden="true">→</span>}
                </span>
                <span class="caps self-start text-[1.5rem] sm:order-3 lg:text-[1.75rem]">{name}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="sheet" aria-labelledby="materials-title">
      <SheetHead no="03" id="materials-title">{h.materialsLabel}</SheetHead>
      <div class="grid grid-cols-1 lg:grid-cols-[3fr_7fr]">
        {
          legend.map((group, g) => (
            <div class:list={[g === 1 && 'border-t border-line lg:border-t-0 lg:border-l']}>
              <h3 class="caps border-b border-line px-3 py-2 text-[1.375rem] sm:px-4">{group.heading}</h3>
              <ul class:list={['ruled grid', g === 1 ? 'grid-cols-4 sm:grid-cols-7' : 'grid-cols-3']}>
                {group.items.map((m, i) => (
                  <li class="p-2.5 lg:p-3">
                    <span class="mb-1.5 block aspect-[3/2] border border-line sm:mb-2 sm:aspect-[4/3]">
                      <Hatch material={m} uid={`${group.code}${i}`} />
                    </span>
                    <span class="mono block text-muted">{group.code}{i + 1}</span>
                    <span class="block text-[0.9375rem] leading-snug">{m}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="sheet" aria-labelledby="showroom-title">
      <SheetHead no="04" id="showroom-title">{h.showroomLabel}</SheetHead>
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div class="grid grid-cols-5 items-start gap-3 p-3 lg:gap-4 lg:p-4">
          <Fig image={showroom.image} caption={showroom.caption} no={2} ratio="4 / 5" group="home-visit" sizes="(min-width: 1024px) 28vw, 58vw" class="col-span-3" />
          <Fig image={shop.image} caption={shop.caption} no={3} ratio="4 / 5" group="home-visit" sizes="(min-width: 1024px) 18vw, 38vw" class="col-span-2" />
        </div>
        <div class="wrap border-t border-line py-6 lg:border-t-0 lg:border-l lg:py-8">
          {h.showroomText && <p class="lead mb-6 max-w-[30ch]">{h.showroomText}</p>}
          <dl class="mb-7 grid gap-6 sm:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
            <div>
              <dt class="mono mb-2 text-muted">Visit</dt>
              <dd class="mb-4"><a href={site.mapsUrl} rel="noopener" class="ulink">{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</a></dd>
              <dt class="mono mb-1 text-muted">Call</dt>
              <dd><a href={site.phoneHref} class="caps text-[1.75rem] tabular-nums hover:text-pencil">{site.phone}</a></dd>
            </div>
            <div>
              <dt class="mono mb-2 text-muted">Showroom hours</dt>
              <dd><Hours class="hours-table" /></dd>
            </div>
          </dl>
          <p class="flex flex-wrap gap-2">
            {h.showroomButton && <a href="#appointment" class="btn">{h.showroomButton} <span aria-hidden="true">→</span></a>}
            {h.contactButton && <a href="/contact" class="btn btn-ghost">{h.contactButton}</a>}
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  @media (min-width: 64rem) {
    /* Photo and ticket together fill the rest of the first screen. */
    .hero-row {
      min-height: min(calc(100svh - 18.75rem), 46rem);
    }
  }
</style>
