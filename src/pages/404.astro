---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tiles from '../components/hearth/Tiles.astro';
---

<BaseLayout title="Page not found">
  <section class="band text-center" aria-labelledby="page-title">
    <div class="wrap">
      <p class="meta mb-6 text-muted">404</p>
      <h1 id="page-title" class="title mb-10">Page not found</h1>
      <a href="/" class="btn">Go to the home page</a>
    </div>
  </section>
  <section class="wrap pb-24"><Tiles /></section>
</BaseLayout>
