---
import BaseLayout from '../layouts/BaseLayout.astro';
import Products from '../components/sheet/Products.astro';
---

<BaseLayout title="Page not found">
  <section class="frame section" aria-labelledby="page-title">
    <h1 id="page-title" class="page-title mb-3">Page not found</h1>
    <a href="/" class="btn">Go to the home page</a>
  </section>
  <section class="frame pb-[clamp(1.25rem,2.4vw,2.25rem)]" aria-label="Cabinets and products"><Products /></section>
</BaseLayout>
