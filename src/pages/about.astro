---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Fig from '../components/sheet/Fig.astro';
import { getPage, getBrandGroups } from '../lib/content';
import { site } from '../lib/site';

const about = await getPage('about');
const { Content } = await render(about);
const brands = await getBrandGroups();
const h = (await getPage('home')).data;
const photos = about.data.photos ?? [];
const exterior = photos.find((p) => p.caption.startsWith('Our Small Business'));
const others = photos.filter((p) => p !== exterior);
---

<BaseLayout title={about.data.seoTitle} image={exterior?.image}>
  <section class="frame section grid grid-cols-1 gap-5 lg:grid-cols-2 lg:gap-10" aria-labelledby="page-title">
    <div>
      <h1 id="page-title" class="page-title mb-3">About {site.name}</h1>
      <div class="lead !text-[1.25rem] !leading-[1.55]"><Content /></div>
      {h.showroomButton && <p class="mt-4"><a href="/#appointment" class="btn">{h.showroomButton}</a></p>}
    </div>
    {exterior && <Fig image={exterior.image} caption={exterior.caption} ratio="16 / 10" group="about" eager sizes="(min-width: 1024px) 45vw, 92vw" />}
  </section>

  <section class="frame section" aria-label="Our showroom and shop">
    <ul class="grid grid-cols-2 gap-3 lg:grid-cols-5">
      {others.map((p) => <li><Fig image={p.image} caption={p.caption} ratio="4 / 5" group="about" sizes="(min-width: 1024px) 18vw, 46vw" /></li>)}
    </ul>
  </section>

  <section class="frame section" aria-labelledby="lines-title">
    <h2 id="lines-title" class="heading mb-3">Lines we distribute</h2>
    <div class="grid grid-cols-2 gap-x-5 gap-y-5 lg:grid-cols-4">
      {
        brands.map((g) => (
          <section aria-label={g.data.label}>
            <h3 class="mb-2 font-semibold">{g.data.label}</h3>
            <ul class="space-y-0.5 leading-snug">
              {g.data.items.map((b) => (
                <li>{b.url ? <a href={b.url} rel="noopener" class="hover:text-pencil hover:underline hover:underline-offset-4">{b.name}</a> : <span>{b.name}</span>}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
