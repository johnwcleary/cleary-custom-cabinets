---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../lib/site';
import { getPage } from '../lib/content';
import { businessSchema, ldJson } from '../lib/seo';
import '../styles/global.css';

interface Props {
  /** Page part of the title; rendered as "{title} — Cleary Custom Cabinets". */
  title: string;
  description?: string;
  /** Open Graph image; defaults to the home hero. */
  image?: ImageMetadata;
  /** The small map in the footer; off where the page shows a large one. */
  footerMap?: boolean;
  /** "article" on a blog post. */
  type?: 'website' | 'article';
  /** Extra structured data for this page (a blog post's own entry). */
  schema?: Record<string, unknown>[];
}

const { title, footerMap = true, type = 'website', schema = [] } = Astro.props;
// A page with no description of its own (or an empty one) uses the site's.
const description = Astro.props.description || site.metaDescription;
const fullTitle = `${title} — ${site.name}`;
// Canonical URL on the production domain (astro.config `site`).
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogSource = Astro.props.image ?? (await getPage('home')).data.heroImage!;
const og = await getImage({ src: ogSource, width: Math.min(1200, ogSource.width), format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);
const structured = [businessSchema(Astro.site!, ogUrl.href), ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width ?? '')} />
    <meta property="og:image:height" content={String(og.attributes.height ?? '')} />
    <meta name="twitter:card" content="summary_large_image" />
    {structured.map((data) => <script type="application/ld+json" is:inline set:html={ldJson(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer map={footerMap} />
    <Lightbox />
  </body>
</html>
