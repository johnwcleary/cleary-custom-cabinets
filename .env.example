# Copy to .env (never committed) and fill in. See docs/storyblok.md.

# Settings → Space → "Space ID" (a number)
STORYBLOK_SPACE_ID=

# Settings → Access Tokens → the "Preview" token (reads drafts; used by cms:pull and cms:preview)
STORYBLOK_TOKEN=

# My Account → Personal access tokens → Generate. Only needed for the one-time cms:push; delete it afterwards.
STORYBLOK_PERSONAL_TOKEN=

# Where the space's data is stored: us (default) or eu, ca, ap
STORYBLOK_REGION=us
